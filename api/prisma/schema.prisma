// Schéma de données V2 — Tiraboschi POS / ERP
// Auth + brique ERP (Approvisionnement → Production → Préparation).
// Migrations à exécuter une fois DATABASE_URL (Postgres) fourni : `npm run db:migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ───────────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  SELLER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         Role     @default(SELLER)
  permissions  String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── RÉFÉRENTIELS ─────────────────────────────────────────────────────────────
enum MaterialCategory {
  LEATHER // peaux
  HARDWARE // bouclerie / bijouterie
  LINING // doublure
  PACKAGING
  OTHER
}

model Supplier {
  id           String         @id @default(cuid())
  name         String
  contactEmail String?
  contactPhone String?
  notes        String?
  materials    Material[]
  purchaseOrders PurchaseOrder[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Workshop {
  id               String           @id @default(cuid())
  name             String
  contactEmail     String?
  contactPhone     String?
  notes            String?
  stockMovements   StockMovement[]
  productionOrders ProductionOrder[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Material {
  id                String           @id @default(cuid())
  code              String           @unique // ID matière (codification)
  name              String
  category          MaterialCategory @default(OTHER)
  unit              String           @default("unit") // dm², pièce, m…
  unitCost          Decimal?         @db.Decimal(12, 2)
  currency          String           @default("EUR")
  reorderThreshold  Decimal?         @db.Decimal(12, 2)
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  supplierId        String?
  poLines           PurchaseOrderLine[]
  receiptLines      GoodsReceiptLine[]
  stockMovements    StockMovement[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// ─── APPROVISIONNEMENT ──────────────────────────────────────────────────────
enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  reference  String              @unique
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  supplierId String
  status     PurchaseOrderStatus @default(DRAFT)
  currency   String              @default("EUR")
  lines      PurchaseOrderLine[]
  receipts   GoodsReceipt[]
  orderedAt  DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String
  material        Material      @relation(fields: [materialId], references: [id])
  materialId      String
  quantity        Decimal       @db.Decimal(12, 2)
  unitCost        Decimal       @db.Decimal(12, 2)
}

// Bon de réception matières → arrivée entrepôt
model GoodsReceipt {
  id              String             @id @default(cuid())
  reference       String             @unique
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String?
  receivedAt      DateTime           @default(now())
  lines           GoodsReceiptLine[]
  createdAt       DateTime           @default(now())
}

model GoodsReceiptLine {
  id            String       @id @default(cuid())
  goodsReceipt  GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  goodsReceiptId String
  material      Material     @relation(fields: [materialId], references: [id])
  materialId    String
  quantity      Decimal      @db.Decimal(12, 2)
}

// ─── MOUVEMENTS DE STOCK (ledger transactionnel) ──────────────────────────────
enum StockMovementType {
  RECEIPT_IN // entrée entrepôt
  EXCEPTIONAL_OUT // sortie exceptionnelle (casse, perte, échantillon)
  ISSUE_TO_WORKSHOP // sortie vers atelier
  IN_TRANSIT_TO_WORKSHOP // matières en transit vers l'atelier
  RETURN // retour / réintégration
  ADJUSTMENT // inventaire / correction
}

model StockMovement {
  id          String            @id @default(cuid())
  material    Material          @relation(fields: [materialId], references: [id])
  materialId  String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 2) // signe selon le type (entrée + / sortie -)
  workshop    Workshop?         @relation(fields: [workshopId], references: [id])
  workshopId  String?
  reference   String?
  note        String?
  createdAt   DateTime          @default(now())
  createdById String?
}

// ─── PRODUCTION ───────────────────────────────────────────────────────────────
enum ProductionOrderStatus {
  REQUESTED
  MATERIALS_IN_TRANSIT
  IN_PRODUCTION
  QC
  RECEIVED
  CANCELLED
}

// Ordre de production vers un atelier, déclenché par une commande client
model ProductionOrder {
  id             String                @id @default(cuid())
  reference      String                @unique
  workshop       Workshop              @relation(fields: [workshopId], references: [id])
  workshopId     String
  variantSku     String
  quantity       Int                   @default(1)
  clientOrderRef String? // référence commande client (Shopify) déclencheuse
  status         ProductionOrderStatus @default(REQUESTED)
  receipts       FinishedPieceReceipt[]
  serials        Serial[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

// Bon de réception des pièces produites
model FinishedPieceReceipt {
  id                String          @id @default(cuid())
  reference         String          @unique
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  productionOrderId String
  quantity          Int
  receivedAt        DateTime        @default(now())
}

// ─── TRAÇABILITÉ PIÈCE + PRÉPARATION ──────────────────────────────────────────
enum SerialStatus {
  IN_PRODUCTION
  QC
  AVAILABLE
  SHIPPED
  RETURNED
}

model Serial {
  id                String           @id @default(cuid())
  serial            String           @unique // numéro de série unique par pièce
  variantSku        String
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  productionOrderId String?
  status            SerialStatus     @default(IN_PRODUCTION)
  location          String? // atelier / boutique / stockage / transit
  fulfillmentTasks  FulfillmentTask[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

enum FulfillmentStatus {
  TO_PREPARE
  READY
  SHIPPED
}

// Suivi des commandes à préparer
model FulfillmentTask {
  id              String            @id @default(cuid())
  shopifyOrderRef String
  serial          Serial?           @relation(fields: [serialId], references: [id])
  serialId        String?
  status          FulfillmentStatus @default(TO_PREPARE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}
