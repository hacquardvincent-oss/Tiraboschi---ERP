// Schéma de données V2 — Tiraboschi POS / ERP
// Auth + brique ERP (Approvisionnement → Production → Préparation).
// Migrations à exécuter une fois DATABASE_URL (Postgres) fourni : `npm run db:migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ───────────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  SELLER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         Role     @default(SELLER)
  permissions  String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Référentiel générique : alimente toutes les listes déroulantes des formulaires (Admin).
// category ∈ models, years, seasons, options, optionTypes, colors, sizes, globalMaterials,
// animalTypes, skinTypes, linings, materialDetails, suppliers, jewelry, origins, hsCodes, ateliers…
model RefItem {
  id        String   @id @default(cuid())
  category  String
  code      String // ID métier (ex. AA001, 999, H)
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, code])
  @@index([category])
}

// ─── PLM : fiche technique produit (Collection) ───────────────────────────────
enum ProductStatus {
  DRAFT // Brouillon
  IN_REVIEW // En revue (workflow PLM)
  VALIDATED // Validé
}

model Product {
  id   String @id @default(cuid())
  sku  String @unique
  name String

  status ProductStatus @default(DRAFT)

  // Composants du SKU (codes issus du référentiel)
  modelCode    String?
  yearCode     String?
  seasonCode   String?
  materialCode String? // ex. CU002 / CE001
  optionCode   String?
  colorCode    String?
  sizeCode     String?

  // BOM (nomenclature) — codes du référentiel + détails libres
  animalCode   String?
  skinTypeCode String?
  liningCode   String?
  atelierCode  String?
  supplierCode String?
  jewelryCodes String[] @default([])
  packaging    String?
  bom          Json?

  // Finance
  priceHtEur        Decimal? @db.Decimal(12, 2)
  priceHtUsd        Decimal? @db.Decimal(12, 2)
  costMaterial      Decimal? @db.Decimal(12, 2)
  costMaking        Decimal? @db.Decimal(12, 2)
  dutiesShippingUsd Decimal? @db.Decimal(12, 2)
  finalPriceDdp     Decimal? @db.Decimal(12, 2)

  // Logistique & douanes
  hsCode        String?
  countryOrigin String?

  // Sync Shopify
  shopifyProductId String?
  imageUrl         String? // visuel de couverture (CDN Shopify ou 1ʳᵉ image de la galerie)

  // Workflow PLM : traçabilité de la validation
  validatedAt DateTime?
  validatedBy String? // email de l'auteur de la validation

  bomLines  BomLine[]
  images    ProductImage[]
  comments  ProductComment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Galerie d'images d'une fiche produit (médias PLM). La 1ʳᵉ (sortOrder) = couverture.
model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// Fil de commentaires d'une fiche produit (échanges PLM, validation, retours atelier).
model ProductComment {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  author    String // email de l'auteur (utilisateur connecté)
  body      String
  createdAt DateTime @default(now())

  @@index([productId])
}

// Paramètres globaux clé/valeur (frais de port, etc.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── RÉFÉRENTIELS ─────────────────────────────────────────────────────────────
enum MaterialCategory {
  LEATHER // peaux
  HARDWARE // bouclerie / bijouterie
  LINING // doublure
  PACKAGING
  OTHER
}

model Supplier {
  id           String         @id @default(cuid())
  name         String
  contactEmail String?
  contactPhone String?
  notes        String?
  materials    Material[]
  purchaseOrders PurchaseOrder[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Workshop {
  id               String           @id @default(cuid())
  name             String
  contactEmail     String?
  contactPhone     String?
  notes            String?
  location         String?
  leadTimeDays     Int? // délai de fabrication forfaitaire
  capacityPerMonth Int? // capacité indicative (pièces/mois)
  moq              Int? // quantité minimale par lancement
  transitDays      Int? // transit entrepôt ↔ atelier (jours)
  shippingCost     Decimal?         @db.Decimal(12, 2)
  capabilities     WorkshopCapability[]
  stockMovements   StockMovement[]
  productionOrders ProductionOrder[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// Matrice de compétences : quels modèles un atelier sait produire (+ délai éventuel par modèle)
model WorkshopCapability {
  id           String   @id @default(cuid())
  workshop     Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  workshopId   String
  modelCode    String // code modèle du référentiel
  leadTimeDays Int? // override du délai pour ce modèle
  createdAt    DateTime @default(now())

  @@unique([workshopId, modelCode])
  @@index([modelCode])
}

model Material {
  id                String           @id @default(cuid())
  code              String           @unique // ID matière (codification)
  name              String
  category          MaterialCategory @default(OTHER)
  unit              String           @default("unit") // dm², pièce, m…
  unitCost          Decimal?         @db.Decimal(12, 2)
  currency          String           @default("EUR")
  reorderThreshold  Decimal?         @db.Decimal(12, 2)
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  supplierId        String?
  poLines           PurchaseOrderLine[]
  receiptLines      GoodsReceiptLine[]
  stockMovements    StockMovement[]
  bomLines          BomLine[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// Ligne de nomenclature chiffrée : matière réelle consommée par un produit (quantité + unité)
model BomLine {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  material   Material @relation(fields: [materialId], references: [id])
  materialId String
  role       String   @default("principale") // principale / secondaire / tertiaire / doublure / bijouterie
  quantity   Decimal  @db.Decimal(12, 3)
  unit       String   @default("piece") // dm² / feet / piece …
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([materialId])
}

// ─── APPROVISIONNEMENT ──────────────────────────────────────────────────────
enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  reference  String              @unique
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  supplierId String
  status     PurchaseOrderStatus @default(DRAFT)
  currency   String              @default("EUR")
  lines      PurchaseOrderLine[]
  receipts   GoodsReceipt[]
  orderedAt  DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String
  material        Material      @relation(fields: [materialId], references: [id])
  materialId      String
  quantity        Decimal       @db.Decimal(12, 2)
  unitCost        Decimal       @db.Decimal(12, 2)
}

// Bon de réception matières → arrivée entrepôt
model GoodsReceipt {
  id              String             @id @default(cuid())
  reference       String             @unique
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String?
  receivedAt      DateTime           @default(now())
  lines           GoodsReceiptLine[]
  createdAt       DateTime           @default(now())
}

model GoodsReceiptLine {
  id            String       @id @default(cuid())
  goodsReceipt  GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  goodsReceiptId String
  material      Material     @relation(fields: [materialId], references: [id])
  materialId    String
  quantity      Decimal      @db.Decimal(12, 2)
}

// ─── MOUVEMENTS DE STOCK (ledger transactionnel) ──────────────────────────────
enum StockMovementType {
  RECEIPT_IN // entrée entrepôt
  EXCEPTIONAL_OUT // sortie exceptionnelle (casse, perte, échantillon)
  ISSUE_TO_WORKSHOP // sortie vers atelier
  IN_TRANSIT_TO_WORKSHOP // matières en transit vers l'atelier
  RETURN // retour / réintégration
  ADJUSTMENT // inventaire / correction
}

model StockMovement {
  id          String            @id @default(cuid())
  material    Material          @relation(fields: [materialId], references: [id])
  materialId  String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 2) // signe selon le type (entrée + / sortie -)
  workshop    Workshop?         @relation(fields: [workshopId], references: [id])
  workshopId  String?
  reference   String?
  note        String?
  createdAt   DateTime          @default(now())
  createdById String?
}

// ─── PRODUCTION ───────────────────────────────────────────────────────────────
enum ProductionOrderStatus {
  REQUESTED
  MATERIALS_IN_TRANSIT
  IN_PRODUCTION
  QC
  RECEIVED
  CANCELLED
}

// Ordre de production vers un atelier, déclenché par une commande client
model ProductionOrder {
  id             String                @id @default(cuid())
  reference      String                @unique
  workshop       Workshop              @relation(fields: [workshopId], references: [id])
  workshopId     String
  variantSku     String
  quantity       Int                   @default(1)
  clientOrderRef String? // référence commande client (Shopify) déclencheuse
  status         ProductionOrderStatus @default(REQUESTED)
  receipts       FinishedPieceReceipt[]
  serials        Serial[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

// Bon de réception des pièces produites
model FinishedPieceReceipt {
  id                String          @id @default(cuid())
  reference         String          @unique
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  productionOrderId String
  quantity          Int
  receivedAt        DateTime        @default(now())
}

// ─── INVENTAIRE TOURNANT (sessions de comptage) ───────────────────────────────
model InventorySession {
  id          String           @id @default(cuid())
  reference   String           @unique
  category    String? // filtre (MaterialCategory) ; null = toutes
  status      String           @default("OPEN") // OPEN | CLOSED
  note        String?
  createdById String?
  createdAt   DateTime         @default(now())
  closedAt    DateTime?
  counts      InventoryCount[]
}

model InventoryCount {
  id          String           @id @default(cuid())
  session     InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  materialId  String
  theoretical Decimal          @db.Decimal(12, 3) // stock théorique figé à l'ouverture
  counted     Decimal?         @db.Decimal(12, 3) // comptage saisi

  @@unique([sessionId, materialId])
  @@index([materialId])
}

// ─── TRAÇABILITÉ PIÈCE + PRÉPARATION ──────────────────────────────────────────
enum SerialStatus {
  IN_PRODUCTION
  QC
  AVAILABLE
  SHIPPED
  RETURNED
}

model Serial {
  id                String           @id @default(cuid())
  serial            String           @unique // numéro de série unique par pièce
  variantSku        String
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  productionOrderId String?
  status            SerialStatus     @default(IN_PRODUCTION)
  location          String? // atelier / boutique / stockage / transit
  fulfillmentTasks  FulfillmentTask[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

enum FulfillmentStatus {
  TO_PREPARE
  READY
  SHIPPED
}

// Suivi des commandes à préparer
model FulfillmentTask {
  id              String            @id @default(cuid())
  shopifyOrderRef String
  serial          Serial?           @relation(fields: [serialId], references: [id])
  serialId        String?
  status          FulfillmentStatus @default(TO_PREPARE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// ─── VENTES (POS) : socle d'encaissement fiable ───────────────────────────────
enum SaleStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum SaleSyncStatus {
  PENDING
  SYNCED
  FAILED
}

// Vente POS = source de vérité durable. Le worker crée la commande Shopify
// (idempotent + retries + statut) → la commande ne peut plus être perdue en silence.
model Sale {
  id            String  @id @default(cuid())
  reference     String  @unique
  market        String // FR | US
  currency      String // EUR | USD
  customerEmail String?
  customerName  String?
  customer      Json? // { firstName,lastName,email,phone,phoneExt,address1,address2,city,zip,province,country,acceptsEmail,acceptsSms,note }
  items         Json // [{ title, sku?, priceCents, qty }]
  taxLines      Json? // [{ title, rate?, amountCents }]
  subtotalCents Int     @default(0)
  taxCents      Int     @default(0)
  shippingCents Int     @default(0)
  totalCents    Int     @default(0)

  status SaleStatus @default(PENDING)

  // Paiement
  stripeAccount         String? // FR | US
  stripePaymentIntentId String?
  stripeSessionId       String?
  paymentUrl            String? // lien de paiement Stripe Checkout (hébergé)
  paidAt                DateTime?

  // Synchronisation Shopify (outbox)
  syncStatus       SaleSyncStatus @default(PENDING)
  syncAttempts     Int            @default(0)
  syncError        String?
  shopifyOrderId   String?
  shopifyOrderName String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([syncStatus])
}
