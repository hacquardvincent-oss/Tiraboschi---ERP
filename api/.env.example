# Backend V2 — variables d'environnement
PORT=3001
NODE_ENV=development

# Shopify (app personnalisée V2 — flux client_credentials)
# Domaine technique .myshopify.com (PAS le domaine public tiraboschi-paris.com)
SHOPIFY_STORE_DOMAIN=axp150-71.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-04

# Clé partagée pour récupération + réconciliation (header x-recovery-key) — provisoire avant l'auth JWT
RECOVERY_KEY=

# Stripe — clés restreintes LECTURE SEULE (réconciliation/watchdog). Un compte par entité.
STRIPE_API_KEY_FR=
STRIPE_API_KEY_US=
# Intervalle du watchdog en ms (défaut 6h)
# WATCHDOG_INTERVAL_MS=21600000
# Webhook d'alerte (Slack / Discord / générique) — alerte quand un paiement n'est pas dans Shopify
ALERT_WEBHOOK_URL=

# Stripe — ENCAISSEMENT (brique 3b.2 lien + 3b.3 TPE S710). Clés SECRÈTES write, un compte par marché.
# (FR = entité France, US = TIRABOSCHI LLC). Webhook signé : configurer l'endpoint
#   https://<PUBLIC_URL>/api/stripe/webhook/FR   (events: checkout.session.completed, payment_intent.succeeded)
#   https://<PUBLIC_URL>/api/stripe/webhook/US
# puis coller le secret de signature (whsec_…) dans STRIPE_WEBHOOK_SECRET_*.
STRIPE_SECRET_KEY_FR=
STRIPE_SECRET_KEY_US=
STRIPE_WEBHOOK_SECRET_FR=
STRIPE_WEBHOOK_SECRET_US=
# Clés publiques + Location Terminal (S710) par marché — pour le pilotage du lecteur côté front.
STRIPE_PUBLISHABLE_KEY_FR=
STRIPE_PUBLISHABLE_KEY_US=
STRIPE_TERMINAL_LOCATION_FR=
STRIPE_TERMINAL_LOCATION_US=
# URL publique de l'app (success/cancel des liens de paiement).
PUBLIC_URL=https://tiraboschi-ops-v2.onrender.com

# Postgres (Neon recommandé) — connexion directe + sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/tiraboschi_erp?sslmode=require

# Origine(s) du frontend autorisées (CORS), séparées par des virgules
FRONTEND_ORIGIN=https://tiraboschi-erp-web.onrender.com

# Auth JWT
JWT_SECRET=
# Admin initial (seed au boot si absent)
ADMIN_EMAIL=
ADMIN_PASSWORD=
