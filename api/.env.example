# Backend V2 — variables d'environnement
PORT=3001
NODE_ENV=development

# Shopify (app personnalisée V2 — flux client_credentials)
# Domaine technique .myshopify.com (PAS le domaine public tiraboschi-paris.com)
SHOPIFY_STORE_DOMAIN=axp150-71.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-04

# Clé partagée pour l'outil de récupération (header x-recovery-key) — provisoire avant l'auth JWT
RECOVERY_KEY=

# Postgres (ajouté à l'étape Prisma)
# DATABASE_URL=postgresql://user:pass@host:5432/tiraboschi_erp
